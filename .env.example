# Neon Postgres connection string (Neon console -> Connect -> copy the pooled URL)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Google AI Studio key. Use a billing-enabled project for real candidate data:
# free-tier inputs may be used by Google to improve its models.
# One key, or several comma-separated keys (used in order; an expired or rate-limited key is skipped)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Resend - leave blank until session B
RESEND_API_KEY=
# Without a verified domain Resend only delivers from onboarding@resend.dev to your own account email.
EMAIL_FROM=Kargo Hiring <onboarding@resend.dev>
# Optional safety net: send EVERY email here instead of the candidate's address
EMAIL_OVERRIDE_TO=

# Optional: protect the dashboard with a single password (recommended once deployed)
DASHBOARD_PASSWORD=

# Optional tuning of "the line"
# INVITE_TOP_N=5
# INVITE_MIN_SCORE=55
# BRIEF_TOP_N=5
